# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env

# --- AI providers ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_S=10

# Любой OpenAI-совместимый API: OpenRouter, DeepSeek, Groq, LM Studio,
# llama.cpp. Включается, когда заданы и адрес, и модель.
#   OpenRouter: https://openrouter.ai/api/v1
#   DeepSeek:   https://api.deepseek.com/v1
#   Groq:       https://api.groq.com/openai/v1
#   LM Studio:  http://localhost:1234/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Более сильная модель для режима «Точная» (необязательно)
OPENAI_MODEL_ACCURATE=

# Ollama (опциональный fallback, см. Phase 1.5 — включить при наличии Ollama)
OLLAMA_ENABLED=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# --- HTTP server ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8765
# Оставьте пустым: токен будет сгенерирован при первом старте
# и сохранён в каталоге настроек (его путь покажет `lms-tool doctor`)
BACKEND_TOKEN=

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./quiz.db

# --- CDP (engine mode) ---
CDP_PORT=9222

# --- Logging ---
LOG_LEVEL=INFO
LOG_EVENTS=true
